# === API / CORS ===
# Comma-separated list of allowed frontend URLs (e.g. https://your-firebase-app.web.app,http://localhost:5173)
FRONTEND_URL=*

# === AI Providers ===
MODEL=gemini/gemini-1.5-pro
GEMINI_API_KEY=
AI_IMAGE_PROVIDER=GOOGLE
# OPENAI_API_KEY= # (Optional: Only if you still want to use OpenAI)
# AZURE_API_KEY=
SERPER_API_KEY=

# === Databases ===
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Weaviate Cloud Configuration (Set USE_VECTOR_DB=false to disable)
USE_VECTOR_DB=false
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_GRPC_PORT=
WEAVIATE_GRPC_URL=

# === File Storage & APIs ===
LOGO_SECRET_KEY=

# Google Cloud Storage Configuration
GCS_BUCKET_NAME=product-images-bucket
# (If running locally, set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json)
# GOOGLE_APPLICATION_CREDENTIALS=
